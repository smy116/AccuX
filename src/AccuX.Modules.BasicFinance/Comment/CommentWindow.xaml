<Window x:Class="AccuX.Modules.BasicFinance.Comment.CommentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="批注助手"
        Width="480"
        Height="360"
        MinWidth="360"
        MinHeight="280"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        PreviewKeyDown="OnPreviewKeyDown">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="批注内容" Margin="0,0,0,6" />

        <TextBox x:Name="ContentBox"
                 Grid.Row="1"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Disabled"
                 TextWrapping="Wrap"
                 VerticalContentAlignment="Top"
                 Padding="6"
                 TextChanged="OnTextChanged" />

        <TextBlock x:Name="CounterText"
                   Grid.Row="2"
                   HorizontalAlignment="Right"
                   Margin="0,6,0,10"
                   Foreground="#666666" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="批注类型" VerticalAlignment="Center" Margin="0,0,16,0" />
            <RadioButton x:Name="PlainRadio"
                         Content="普通批注"
                         IsChecked="True"
                         VerticalAlignment="Center"
                         Margin="0,0,18,0"
                         Checked="OnKindChanged" />
            <RadioButton x:Name="EncryptedRadio"
                         Content="加密批注"
                         VerticalAlignment="Center"
                         Checked="OnKindChanged" />
        </StackPanel>

        <TextBlock x:Name="HintText"
                   Grid.Row="4"
                   TextWrapping="Wrap"
                   Foreground="#666666"
                   Margin="0,0,0,12" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SaveButton"
                    Content="保存"
                    Width="72"
                    Height="26"
                    Margin="0,0,8,0"
                    Click="OnSave" />
            <Button x:Name="DeleteButton"
                    Content="删除"
                    Width="72"
                    Height="26"
                    Click="OnDelete" />
        </StackPanel>
    </Grid>
</Window>
