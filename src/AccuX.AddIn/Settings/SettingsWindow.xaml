<Window x:Class="AccuX.AddIn.Settings.SettingsWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AccuX 设置"
        Width="580"
        MinWidth="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="应用信息" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="_currentVersionText" FontWeight="Bold" />
                <TextBlock x:Name="_configPathText" Margin="0,8,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="1" Header="处理限制" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="警告单元格数量：" VerticalAlignment="Center" Margin="0,0,10,8" />
                <TextBox x:Name="_warningBox"
                         Grid.Column="1"
                         Padding="5,3"
                         Margin="0,0,0,8"
                         HorizontalContentAlignment="Left" />

                <TextBlock Grid.Row="1" Text="最大单元格数量：" VerticalAlignment="Center" Margin="0,0,10,8" />
                <TextBox x:Name="_maxBox"
                         Grid.Row="1"
                         Grid.Column="1"
                         Padding="5,3"
                         Margin="0,0,0,8"
                         HorizontalContentAlignment="Left" />

                <TextBlock Grid.Row="2"
                           Grid.ColumnSpan="2"
                           Text="警告阈值以上会请求确认；最大阈值以上会拒绝处理。区域对比使用两个区域的合计数量。"
                           Foreground="Gray"
                           TextWrapping="Wrap"
                           Margin="0,2,0,0" />
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="升级" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <CheckBox x:Name="_autoCheckBox"
                          Content="启动后自动检测升级（每天最多一次）"
                          Margin="0,0,0,8" />
                <TextBlock x:Name="_lastCheckText" Foreground="Gray" TextWrapping="Wrap" />
                <TextBlock x:Name="_updateStatusText" TextWrapping="Wrap" Margin="0,6,0,6" />
                <TextBox x:Name="_releaseNotesBox"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Height="100"
                         Visibility="Collapsed"
                         Margin="0,0,0,8" />

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="_manualCheckButton"
                            Content="手动检测升级"
                            Width="110"
                            Height="28"
                            Margin="0,0,8,0"
                            Click="OnManualCheck" />
                    <Button x:Name="_installButton"
                            Content="下载并安装"
                            Width="100"
                            Height="28"
                            Margin="0,0,8,0"
                            IsEnabled="False"
                            Click="OnInstall" />
                    <Button x:Name="_releasePageButton"
                            Content="查看更新说明"
                            Width="110"
                            Height="28"
                            IsEnabled="False"
                            Click="OnOpenReleasePage" />
                </StackPanel>

                <ProgressBar x:Name="_downloadProgress"
                             Height="5"
                             Minimum="0"
                             Maximum="100"
                             Visibility="Collapsed"
                             Margin="0,10,0,0" />
            </StackPanel>
        </GroupBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="保存"
                    Width="76"
                    Height="28"
                    IsDefault="True"
                    Margin="0,0,8,0"
                    Click="OnSave" />
            <Button Content="取消" Width="76" Height="28" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
