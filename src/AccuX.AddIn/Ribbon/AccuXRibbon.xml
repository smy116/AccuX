<?xml version="1.0" encoding="UTF-8"?>
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" onLoad="OnRibbonLoad">
  <ribbon>
    <tabs>
      <tab id="AccuXTab" label="AccuX" insertAfterMso="TabHome">
        <group id="AccuXBasicFinanceGroup" label="基础功能">
          <box id="AccuXBasicFinanceLayout" boxStyle="vertical">
            <box id="AccuXBasicFinanceTopRow" boxStyle="horizontal">
              <button id="accux.basic.round"
                      label="一键舍入"
                      size="normal"
                      onAction="OnAction"
                      getImage="GetImage"
                      screentip="一键舍入"
                      supertip="对当前选区金额统一四舍五入，可自定义小数位。" />
              <button id="accux.basic.convert"
                      label="金额折合"
                      size="normal"
                      onAction="OnAction"
                      getImage="GetImage"
                      screentip="金额折合"
                      supertip="按除百 / 除千 / 除万对选区金额进行折合。" />
              <button id="accux.basic.sum"
                      label="选区求和"
                      size="normal"
                      onAction="OnAction"
                      getImage="GetImage"
                      screentip="选区求和"
                      supertip="计算当前选区内可见数字合计，四舍五入到2位并复制到剪切板。" />
            </box>
            <box id="AccuXBasicFinanceBottomRow" boxStyle="horizontal">
              <button id="accux.basic.uppercase"
                      label="金额大写"
                      size="normal"
                      onAction="OnAction"
                      getImage="GetImage"
                      screentip="金额大写"
                      supertip="将当前选区金额转换为中文大写。" />
              <button id="accux.basic.directory"
                      label="生成目录"
                      size="normal"
                      onAction="OnAction"
                      getImage="GetImage"
                      screentip="生成目录"
                      supertip="在工作簿最前面生成可见工作表目录。" />
              <button id="accux.basic.comment"
                      label="批注助手"
                      size="normal"
                      onAction="OnAction"
                      getImage="GetImage"
                      screentip="批注助手"
                      supertip="查看、保存或删除当前选区左上角单元格的批注。" />
            </box>
          </box>
        </group>
        <group id="AccuXMarkGroup" label="标记">
          <box id="AccuXMarkLayout" boxStyle="vertical">
            <box id="AccuXMarkTopRow" boxStyle="horizontal">
              <button id="accux.mark.green"
                      label="标绿"
                      size="normal"
                      onAction="OnAction"
                      getImage="GetImage"
                      screentip="标绿"
                      supertip="将当前选区中的可见单元格底色设置为绿色。" />
              <button id="accux.mark.red"
                      label="标红"
                      size="normal"
                      onAction="OnAction"
                      getImage="GetImage"
                      screentip="标红"
                      supertip="将当前选区中的可见单元格底色设置为红色。" />
            </box>
            <box id="AccuXMarkBottomRow" boxStyle="horizontal">
              <button id="accux.mark.yellow"
                      label="标黄"
                      size="normal"
                      onAction="OnAction"
                      getImage="GetImage"
                      screentip="标黄"
                      supertip="将当前选区中的可见单元格底色设置为黄色。" />
              <button id="accux.mark.blue"
                      label="标蓝"
                      size="normal"
                      onAction="OnAction"
                      getImage="GetImage"
                      screentip="标蓝"
                      supertip="将当前选区中的可见单元格底色设置为蓝色。" />
            </box>
          </box>
        </group>
        <group id="AccuXCompareGroup" label="对比">
          <button id="accux.compare.exists"
                  label="区域对比"
                  size="large"
                  onAction="OnAction"
                  getImage="GetImage"
                  screentip="区域对比"
                  supertip="比较两个区域中出现过的单元格值，并按区域独有与相同项分类。" />
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
