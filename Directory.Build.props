<Project>

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <NeutralLanguage>zh-CN</NeutralLanguage>

    <Company>AccuX</Company>
    <Product>AccuX</Product>
    <Authors>AccuX</Authors>
    <!--
      Public release tags are two-part (v1.6) or three-part (v1.6.1). build.ps1
      turns the semantic version into the CLR's four-part assembly/file version
      (1.6.1.0) on release, and CI injects the same properties for test builds.

      The defaults below only apply to a bare `dotnet build` / Visual Studio
      build; they intentionally look like a development build so a local
      artifact can never be mistaken for a published release.
    -->
    <Version Condition="'$(Version)' == ''">0.0.0-dev</Version>
    <FileVersion Condition="'$(FileVersion)' == ''">0.0.0.0</FileVersion>
    <AssemblyVersion Condition="'$(AssemblyVersion)' == ''">0.0.0.0</AssemblyVersion>
    <AccuXVersion Condition="'$(AccuXVersion)' == ''">0.0.0-dev</AccuXVersion>
    <!-- 版本号的唯一来源是 tag / CI 参数；不要把源码提交号拼进 InformationalVersion。 -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <!--
      CI supplies OfficePiaPath explicitly. On a developer machine prefer the
      Visual Studio Office 15 PIA, then let the project files fall back to the
      existing GAC paths when that directory is unavailable.
    -->
    <OfficePiaPath Condition="'$(OfficePiaPath)' == '' and Exists('$(MSBuildProgramFiles32)\Microsoft Visual Studio\Shared\Visual Studio Tools for Office\PIA\Office15')">$(MSBuildProgramFiles32)\Microsoft Visual Studio\Shared\Visual Studio Tools for Office\PIA\Office15</OfficePiaPath>
    <OfficePiaPath Condition="'$(OfficePiaPath)' == '' and Exists('$(ProgramFiles)\Microsoft Visual Studio\Shared\Visual Studio Tools for Office\PIA\Office15')">$(ProgramFiles)\Microsoft Visual Studio\Shared\Visual Studio Tools for Office\PIA\Office15</OfficePiaPath>

    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>

    <NoWarn>$(NoWarn);CS1591;NU1701</NoWarn>
  </PropertyGroup>

</Project>
